#, kde-format
msgid "A split references a missing cost center: %1"
msgstr "يشير جزء من المعاملة إلى مركز تكلفة غير موجود: %1"

#, kde-format
msgid "A split references a missing or standard account: %1"
msgstr "يشير جزء من المعاملة إلى حساب غير موجود أو حساب قياسي: %1"

#, kde-format
msgid "A split references a missing payee: %1"
msgstr "يشير جزء من المعاملة إلى مستفيد غير موجود: %1"

#, kde-format
msgid "A split references a missing tag: %1"
msgstr "يشير جزء من المعاملة إلى وسم غير موجود: %1"

#, kde-format
msgid "Account"
msgstr "الحساب"

#, kde-format
msgid "Account '%1' is closed. Reopen it in KMyMoney before moving or restoring this transaction."
msgstr "الحساب «%1» مغلق. أعد فتحه في KMyMoney قبل نقل هذه المعاملة أو استعادتها."

#, kde-format
msgid "Cleared"
msgstr "تم التحقق"

#, kde-format
msgid "Currency"
msgstr "العملة"

#, kde-format
msgid "Date"
msgstr "التاريخ"

#, kde-format
msgid "Draft"
msgstr "مسودة"

#, kde-format
msgid "Draft checksum mismatch. The archive was not changed."
msgstr "المجموع الاختباري للمسودة غير مطابق. لم يُغيَّر الأرشيف."

#, kde-format
msgid "Draft contains missing, unknown, or noncanonical transaction fields."
msgstr "تحتوي المسودة على حقول معاملة مفقودة أو مجهولة أو غير مطابقة للصيغة القياسية."

#, kde-format
msgid "Draft identity does not match its metadata key. No drafts were changed."
msgstr "معرّف المسودة لا يطابق مفتاح بياناتها الوصفية. لم تُغيَّر أي مسودة."

#, kde-format
msgid "Draft metadata is not valid JSON."
msgstr "البيانات الوصفية للمسودة ليست بصيغة JSON صالحة."

#, kde-format
msgid "Draft metadata is too large."
msgstr "البيانات الوصفية للمسودة كبيرة جدًا."

#, kde-format
msgid "Draft metadata must be an object."
msgstr "يجب أن تكون البيانات الوصفية للمسودة كائنًا."

#, kde-format
msgid "Draft metadata values must be strings."
msgstr "يجب أن تكون قيم البيانات الوصفية للمسودة سلاسل نصية."

#, kde-format
msgid "Draft origin split does not exist."
msgstr "الجزء الأصلي للمسودة غير موجود."

#, kde-format
msgid "Draft splits are missing."
msgstr "أجزاء المسودة مفقودة."

#, kde-format
msgid "Draft tags are missing."
msgstr "وسوم المسودة مفقودة."

#, kde-format
msgid "Draft transactions"
msgstr "مسودات المعاملات"

#, kde-format
msgid "Drafted (UTC)"
msgstr "نُقلت إلى المسودات (UTC)"

#, kde-format
msgid "Drafts"
msgstr "المسودات"

#, kde-format
msgid "Drafts do not affect balances. Save the document to keep changes. Restored recovery copies are removed only after a clean save and full verification; cleanup is saved with the next document save."
msgstr "لا تؤثر المسودات في الأرصدة. احفظ المستند للاحتفاظ بالتغييرات. لا تُحذف نسخ الاسترداد للمعاملات المستعادة إلا بعد حفظ ناجح وتحقق كامل؛ ويُحفظ هذا التنظيف عند حفظ المستند في المرة التالية."

#, kde-format
msgid "Every split will return to its original account. Only the posting date can change; reconciliation flags and dates remain unchanged."
msgstr "سيعود كل جزء إلى حسابه الأصلي. يمكن تغيير تاريخ القيد فقط؛ وتبقى علامات المطابقة وتواريخها دون تغيير."

#, kde-format
msgid "Filter drafts…"
msgstr "تصفية المسودات…"

#, kde-format
msgid "Finish the current KMyMoney operation first."
msgstr "أكمل عملية KMyMoney الحالية أولًا."

#, kde-format
msgid "Frozen"
msgstr "مجمّدة"

#, kde-format
msgid "Invalid archived transaction identity or date."
msgstr "معرّف المعاملة المؤرشفة أو تاريخها غير صالح."

#, kde-format
msgid "Invalid draft identity or timestamp."
msgstr "معرّف المسودة أو طابعها الزمني غير صالح."

#, kde-format
msgid "Invalid draft split."
msgstr "جزء غير صالح في المسودة."

#, kde-format
msgid "Invalid draft tag."
msgstr "وسم غير صالح في المسودة."

#, kde-format
msgid "Invalid exact monetary value in draft."
msgstr "قيمة نقدية دقيقة غير صالحة في المسودة."

#, kde-format
msgid "Invalid matched transaction."
msgstr "معاملة مقترنة غير صالحة."

#, kde-format
msgid "Invalid reconciliation state."
msgstr "حالة مطابقة غير صالحة."

#, kde-format
msgid "Invalid restoration recovery record."
msgstr "سجل استرداد الاستعادة غير صالح."

#, kde-format
msgid "KMyMoney changed transaction fields during restoration. The operation was rolled back and the draft was retained."
msgstr "غيّر KMyMoney حقول المعاملة أثناء الاستعادة. تم التراجع عن العملية والاحتفاظ بالمسودة."

#, kde-format
msgid "Keep complete transactions in drafts and restore them later"
msgstr "احتفظ بالمعاملات كاملةً في المسودات واستعدها لاحقًا"

#, kde-format
msgid "Matched transaction nesting is too deep."
msgstr "تداخل المعاملات المقترنة عميق جدًا."

#, kde-format
msgid "Memo"
msgstr "ملاحظة"

#, kde-format
msgid "Missing or duplicate split identity in draft."
msgstr "معرّف جزء مفقود أو مكرر في المسودة."

#, kde-format
msgid "Move the complete selected transactions, including every split, to drafts? They will stop affecting all account balances, reports, and reconciliations."
msgstr "هل تريد نقل المعاملات المحددة كاملةً، بما في ذلك جميع أجزائها، إلى المسودات؟ لن تعود تؤثر في أرصدة أي حساب أو في التقارير والمطابقات."

#, kde-format
msgid "Move to drafts"
msgstr "نقل إلى المسودات"

#, kde-format
msgid "Moving or restoring reconciled transactions changes historical balances. If you change the posting date, review the affected reconciliations afterwards."
msgstr "يغيّر نقل المعاملات المطابَقة أو استعادتها الأرصدة السابقة. إذا غيّرت تاريخ القيد، فراجع المطابقات المتأثرة بعد ذلك."

#, kde-format
msgid "No draft transactions in this document."
msgstr "لا توجد مسودات معاملات في هذا المستند."

#, kde-format
msgid "Not reconciled"
msgstr "غير مطابَقة"

#, kde-format
msgid "Open a KMyMoney document to view its drafts."
msgstr "افتح مستند KMyMoney لعرض مسوداته."

#, kde-format
msgid "Payee"
msgstr "المستفيد"

#, kde-format
msgid "Posting date:"
msgstr "تاريخ القيد:"

#, kde-format
msgid "Price (exact)"
msgstr "السعر (دقيق)"

#, kde-format
msgid "Reconciled"
msgstr "مطابَقة"

#, kde-format
msgid "Reconciliation"
msgstr "المطابقة"

#, kde-format
msgid "Reconciliation date"
msgstr "تاريخ المطابقة"

#, kde-format
msgid "Remove saved restoration copies"
msgstr "إزالة نسخ الاستعادات المحفوظة"

#, kde-format
msgid "Restoration requires a valid posting date and no other active operation."
msgstr "تتطلب الاستعادة تاريخ قيد صالحًا وعدم وجود عملية أخرى نشطة."

#, kde-format
msgid "Restore"
msgstr "استعادة"

#, kde-format
msgid "Restore draft transaction"
msgstr "استعادة مسودة المعاملة"

#, kde-format
msgid "Restored; recovery copy retained"
msgstr "تمت الاستعادة؛ احتُفظ بنسخة الاسترداد"

#, kde-format
msgid "Select at least one saved transaction."
msgstr "حدد معاملة محفوظة واحدة على الأقل."

#, kde-format
msgid "Shares (exact)"
msgstr "الأسهم (دقيقة)"

#, kde-format
msgid "Show drafts…"
msgstr "عرض المسودات…"

#, kde-format
msgid "Splits"
msgstr "الأجزاء"

#, kde-format
msgid "Status"
msgstr "الحالة"

#, kde-format
msgid "The plugin module could not be retained for undo history. Restart KMyMoney and check the plugin installation."
msgstr "تعذر الاحتفاظ بوحدة الملحق لسجل التراجع. أعد تشغيل KMyMoney وتحقق من تثبيت الملحق."

#, kde-format
msgid "The selected ledger split no longer exists."
msgstr "لم يعد جزء دفتر الأستاذ المحدد موجودًا."

#, kde-format
msgid "The transaction currency or security no longer exists."
msgstr "لم تعد عملة المعاملة أو ورقتها المالية موجودة."

#, kde-format
msgid "This draft exceeds the 4 MiB metadata record limit."
msgstr "تتجاوز هذه المسودة حد سجل البيانات الوصفية البالغ 4 MiB."

#, kde-format
msgid "This draft has already been restored. Save the document to finish cleanup."
msgstr "استُعيدت هذه المسودة بالفعل. احفظ المستند لإكمال التنظيف."

#, kde-format
msgid "This draft no longer exists."
msgstr "لم تعد هذه المسودة موجودة."

#, kde-format
msgid "This transaction already has a draft or a pending restoration record. Save the document first."
msgstr "لهذه المعاملة مسودة أو سجل استعادة معلّق بالفعل. احفظ المستند أولًا."

#, kde-format
msgid "This transaction cannot be archived without changes."
msgstr "لا يمكن أرشفة هذه المعاملة دون تغييرات."

#, kde-format
msgid "Unable to move to drafts"
msgstr "تعذر النقل إلى المسودات"

#, kde-format
msgid "Unable to read drafts: %1"
msgstr "تعذرت قراءة المسودات: %1"

#, kde-format
msgid "Unable to restore draft"
msgstr "تعذرت استعادة المسودة"

#, kde-format
msgid "Unknown"
msgstr "غير معروف"

#, kde-format
msgid "Unknown or missing draft fields. Archive left unchanged."
msgstr "حقول مسودة مجهولة أو مفقودة. تُرك الأرشيف دون تغيير."

#, kde-format
msgid "Unsupported draft metadata version. Update the plugin before changing drafts."
msgstr "إصدار غير مدعوم من البيانات الوصفية للمسودة. حدّث الملحق قبل تغيير المسودات."

#, kde-format
msgid "Value"
msgstr "القيمة"

#, kde-format
msgid "Value (%1)"
msgstr "القيمة (%1)"

#, kde-format
#~ msgid "All splits (read-only; exact amounts are shown as fractions)"
#~ msgstr "جميع الأجزاء (للقراءة فقط؛ تظهر المبالغ الدقيقة على شكل كسور)"
