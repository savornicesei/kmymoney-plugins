#, kde-format
msgid "A split references a missing cost center: %1"
msgstr "Una suddivisione fa riferimento a un centro di costo mancante: %1"

#, kde-format
msgid "A split references a missing or standard account: %1"
msgstr "Una suddivisione fa riferimento a un conto mancante o standard: %1"

#, kde-format
msgid "A split references a missing payee: %1"
msgstr "Una suddivisione fa riferimento a un beneficiario mancante: %1"

#, kde-format
msgid "A split references a missing tag: %1"
msgstr "Una suddivisione fa riferimento a un'etichetta mancante: %1"

#, kde-format
msgid "Account"
msgstr "Conto"

#, kde-format
msgid "Account '%1' is closed. Reopen it in KMyMoney before moving or restoring this transaction."
msgstr "Il conto «%1» è chiuso. Riaprilo in KMyMoney prima di spostare o ripristinare questa transazione."

#, kde-format
msgid "Cleared"
msgstr "Verificata"

#, kde-format
msgid "Currency"
msgstr "Valuta"

#, kde-format
msgid "Date"
msgstr "Data"

#, kde-format
msgid "Draft"
msgstr "Bozza"

#, kde-format
msgid "Draft checksum mismatch. The archive was not changed."
msgstr "La somma di controllo della bozza non corrisponde. L'archivio non è stato modificato."

#, kde-format
msgid "Draft contains missing, unknown, or noncanonical transaction fields."
msgstr "La bozza contiene campi della transazione mancanti, sconosciuti o non canonici."

#, kde-format
msgid "Draft identity does not match its metadata key. No drafts were changed."
msgstr "L'identificativo della bozza non corrisponde alla chiave dei metadati. Nessuna bozza è stata modificata."

#, kde-format
msgid "Draft metadata is not valid JSON."
msgstr "I metadati della bozza non sono JSON valido."

#, kde-format
msgid "Draft metadata is too large."
msgstr "I metadati della bozza sono troppo grandi."

#, kde-format
msgid "Draft metadata must be an object."
msgstr "I metadati della bozza devono essere un oggetto."

#, kde-format
msgid "Draft metadata values must be strings."
msgstr "I valori dei metadati della bozza devono essere stringhe."

#, kde-format
msgid "Draft origin split does not exist."
msgstr "La suddivisione di origine della bozza non esiste."

#, kde-format
msgid "Draft splits are missing."
msgstr "Mancano le suddivisioni della bozza."

#, kde-format
msgid "Draft tags are missing."
msgstr "Mancano le etichette della bozza."

#, kde-format
msgid "Draft transactions"
msgstr "Transazioni in bozza"

#, kde-format
msgid "Drafted (UTC)"
msgstr "Salvata come bozza (UTC)"

#, kde-format
msgid "Drafts"
msgstr "Bozze"

#, kde-format
msgid "Drafts do not affect balances. Save the document to keep changes. Restored recovery copies are removed only after a clean save and full verification; cleanup is saved with the next document save."
msgstr "Le bozze non influiscono sui saldi. Salva il documento per conservare le modifiche. Le copie di recupero delle transazioni ripristinate vengono eliminate solo dopo un salvataggio riuscito e una verifica completa; la pulizia viene salvata al successivo salvataggio del documento."

#, kde-format
msgid "Every split will return to its original account. Only the posting date can change; reconciliation flags and dates remain unchanged."
msgstr "Ogni suddivisione tornerà al conto originale. Può cambiare solo la data di registrazione; gli stati e le date di riconciliazione rimangono invariati."

#, kde-format
msgid "Filter drafts…"
msgstr "Filtra bozze…"

#, kde-format
msgid "Finish the current KMyMoney operation first."
msgstr "Termina prima l'operazione in corso in KMyMoney."

#, kde-format
msgid "Frozen"
msgstr "Bloccata"

#, kde-format
msgid "Invalid archived transaction identity or date."
msgstr "Identificativo o data della transazione archiviata non validi."

#, kde-format
msgid "Invalid draft identity or timestamp."
msgstr "Identificativo o marca temporale della bozza non validi."

#, kde-format
msgid "Invalid draft split."
msgstr "Suddivisione della bozza non valida."

#, kde-format
msgid "Invalid draft tag."
msgstr "Etichetta della bozza non valida."

#, kde-format
msgid "Invalid exact monetary value in draft."
msgstr "Valore monetario esatto non valido nella bozza."

#, kde-format
msgid "Invalid matched transaction."
msgstr "Transazione associata non valida."

#, kde-format
msgid "Invalid reconciliation state."
msgstr "Stato di riconciliazione non valido."

#, kde-format
msgid "Invalid restoration recovery record."
msgstr "Registrazione di recupero del ripristino non valida."

#, kde-format
msgid "KMyMoney changed transaction fields during restoration. The operation was rolled back and the draft was retained."
msgstr "KMyMoney ha modificato campi della transazione durante il ripristino. L'operazione è stata annullata e la bozza conservata."

#, kde-format
msgid "Keep complete transactions in drafts and restore them later"
msgstr "Conserva transazioni complete nelle bozze e ripristinale in seguito"

#, kde-format
msgid "Matched transaction nesting is too deep."
msgstr "L'annidamento delle transazioni associate è troppo profondo."

#, kde-format
msgid "Memo"
msgstr "Nota"

#, kde-format
msgid "Missing or duplicate split identity in draft."
msgstr "Identificativo di suddivisione mancante o duplicato nella bozza."

#, kde-format
msgid "Move the complete selected transactions, including every split, to drafts? They will stop affecting all account balances, reports, and reconciliations."
msgstr "Spostare le transazioni selezionate complete, comprese tutte le suddivisioni, nelle bozze? Non influiranno più sui saldi dei conti, sui resoconti e sulle riconciliazioni."

#, kde-format
msgid "Move to drafts"
msgstr "Sposta nelle bozze"

#, kde-format
msgid "Moving or restoring reconciled transactions changes historical balances. If you change the posting date, review the affected reconciliations afterwards."
msgstr "Spostare o ripristinare transazioni riconciliate modifica i saldi storici. Se cambi la data di registrazione, controlla poi le riconciliazioni interessate."

#, kde-format
msgid "No draft transactions in this document."
msgstr "Nessuna transazione in bozza in questo documento."

#, kde-format
msgid "Not reconciled"
msgstr "Non riconciliata"

#, kde-format
msgid "Open a KMyMoney document to view its drafts."
msgstr "Apri un documento KMyMoney per visualizzarne le bozze."

#, kde-format
msgid "Payee"
msgstr "Beneficiario"

#, kde-format
msgid "Posting date:"
msgstr "Data di registrazione:"

#, kde-format
msgid "Price (exact)"
msgstr "Prezzo (esatto)"

#, kde-format
msgid "Reconciled"
msgstr "Riconciliata"

#, kde-format
msgid "Reconciliation"
msgstr "Riconciliazione"

#, kde-format
msgid "Reconciliation date"
msgstr "Data di riconciliazione"

#, kde-format
msgid "Remove saved restoration copies"
msgstr "Elimina le copie dei ripristini salvati"

#, kde-format
msgid "Restoration requires a valid posting date and no other active operation."
msgstr "Il ripristino richiede una data di registrazione valida e nessun'altra operazione attiva."

#, kde-format
msgid "Restore"
msgstr "Ripristina"

#, kde-format
msgid "Restore draft transaction"
msgstr "Ripristina transazione in bozza"

#, kde-format
msgid "Restored; recovery copy retained"
msgstr "Ripristinata; copia di recupero conservata"

#, kde-format
msgid "Select at least one saved transaction."
msgstr "Seleziona almeno una transazione salvata."

#, kde-format
msgid "Shares (exact)"
msgstr "Quote (esatte)"

#, kde-format
msgid "Show drafts…"
msgstr "Mostra bozze…"

#, kde-format
msgid "Splits"
msgstr "Suddivisioni"

#, kde-format
msgid "Status"
msgstr "Stato"

#, kde-format
msgid "The plugin module could not be retained for undo history. Restart KMyMoney and check the plugin installation."
msgstr "Non è stato possibile mantenere il modulo dell'estensione per la cronologia degli annullamenti. Riavvia KMyMoney e verifica l'installazione dell'estensione."

#, kde-format
msgid "The selected ledger split no longer exists."
msgstr "La suddivisione selezionata nel registro non esiste più."

#, kde-format
msgid "The transaction currency or security no longer exists."
msgstr "La valuta o il titolo della transazione non esiste più."

#, kde-format
msgid "This draft exceeds the 4 MiB metadata record limit."
msgstr "Questa bozza supera il limite di 4 MiB per la registrazione dei metadati."

#, kde-format
msgid "This draft has already been restored. Save the document to finish cleanup."
msgstr "Questa bozza è già stata ripristinata. Salva il documento per completare la pulizia."

#, kde-format
msgid "This draft no longer exists."
msgstr "Questa bozza non esiste più."

#, kde-format
msgid "This transaction already has a draft or a pending restoration record. Save the document first."
msgstr "Questa transazione ha già una bozza o una registrazione di ripristino in attesa. Salva prima il documento."

#, kde-format
msgid "This transaction cannot be archived without changes."
msgstr "Questa transazione non può essere archiviata senza modifiche."

#, kde-format
msgid "Unable to move to drafts"
msgstr "Impossibile spostare nelle bozze"

#, kde-format
msgid "Unable to read drafts: %1"
msgstr "Impossibile leggere le bozze: %1"

#, kde-format
msgid "Unable to restore draft"
msgstr "Impossibile ripristinare la bozza"

#, kde-format
msgid "Unknown"
msgstr "Sconosciuto"

#, kde-format
msgid "Unknown or missing draft fields. Archive left unchanged."
msgstr "Campi della bozza sconosciuti o mancanti. L'archivio rimane invariato."

#, kde-format
msgid "Unsupported draft metadata version. Update the plugin before changing drafts."
msgstr "Versione dei metadati della bozza non supportata. Aggiorna l'estensione prima di modificare le bozze."

#, kde-format
msgid "Value"
msgstr "Valore"

#, kde-format
msgid "Value (%1)"
msgstr "Valore (%1)"

#, kde-format
#~ msgid "All splits (read-only; exact amounts are shown as fractions)"
#~ msgstr "Tutte le suddivisioni (sola lettura; gli importi esatti sono mostrati come frazioni)"
