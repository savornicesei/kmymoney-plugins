#, kde-format
msgid "A split references a missing cost center: %1"
msgstr "Rozdelenie odkazuje na chýbajúce nákladové stredisko: %1"

#, kde-format
msgid "A split references a missing or standard account: %1"
msgstr "Rozdelenie odkazuje na chýbajúci alebo štandardný účet: %1"

#, kde-format
msgid "A split references a missing payee: %1"
msgstr "Rozdelenie odkazuje na chýbajúceho príjemcu: %1"

#, kde-format
msgid "A split references a missing tag: %1"
msgstr "Rozdelenie odkazuje na chýbajúcu značku: %1"

#, kde-format
msgid "Account"
msgstr "Účet"

#, kde-format
msgid "Account '%1' is closed. Reopen it in KMyMoney before moving or restoring this transaction."
msgstr "Účet „%1“ je zatvorený. Pred presunom alebo obnovením transakcie ho v KMyMoney znova otvorte."

#, kde-format
msgid "All splits (read-only; exact amounts are shown as fractions)"
msgstr "Všetky rozdelenia (iba na čítanie; presné sumy sa zobrazujú ako zlomky)"

#, kde-format
msgid "Cleared"
msgstr "Skontrolované"

#, kde-format
msgid "Currency"
msgstr "Mena"

#, kde-format
msgid "Date"
msgstr "Dátum"

#, kde-format
msgid "Draft"
msgstr "Koncept"

#, kde-format
msgid "Draft checksum mismatch. The archive was not changed."
msgstr "Kontrolný súčet konceptu sa nezhoduje. Archív sa nezmenil."

#, kde-format
msgid "Draft contains missing, unknown, or noncanonical transaction fields."
msgstr "Koncept obsahuje chýbajúce, neznáme alebo nekanonické polia transakcie."

#, kde-format
msgid "Draft identity does not match its metadata key. No drafts were changed."
msgstr "Identifikátor konceptu nezodpovedá kľúču metadát. Žiadne koncepty sa nezmenili."

#, kde-format
msgid "Draft metadata is not valid JSON."
msgstr "Metadáta konceptu nie sú platný JSON."

#, kde-format
msgid "Draft metadata is too large."
msgstr "Metadáta konceptu sú príliš veľké."

#, kde-format
msgid "Draft metadata must be an object."
msgstr "Metadáta konceptu musia byť objekt."

#, kde-format
msgid "Draft metadata values must be strings."
msgstr "Hodnoty metadát konceptu musia byť reťazce."

#, kde-format
msgid "Draft origin split does not exist."
msgstr "Pôvodné rozdelenie konceptu neexistuje."

#, kde-format
msgid "Draft splits are missing."
msgstr "Chýbajú rozdelenia konceptu."

#, kde-format
msgid "Draft tags are missing."
msgstr "Chýbajú značky konceptu."

#, kde-format
msgid "Draft transactions"
msgstr "Koncepty transakcií"

#, kde-format
msgid "Drafted (UTC)"
msgstr "Presunuté do konceptov (UTC)"

#, kde-format
msgid "Drafts"
msgstr "Koncepty"

#, kde-format
msgid "Drafts do not affect balances. Save the document to keep changes. Restored recovery copies are removed only after a clean save and full verification; cleanup is saved with the next document save."
msgstr "Koncepty neovplyvňujú zostatky. Uložte dokument, aby sa zmeny zachovali. Záchranné kópie obnovených transakcií sa odstránia až po úspešnom uložení a úplnom overení; odstránenie sa uloží pri ďalšom uložení dokumentu."

#, kde-format
msgid "Every split will return to its original account. Only the posting date can change; reconciliation flags and dates remain unchanged."
msgstr "Každé rozdelenie sa vráti na pôvodný účet. Zmeniť možno iba dátum zaúčtovania; príznaky a dátumy odsúhlasenia zostanú nezmenené."

#, kde-format
msgid "Filter drafts…"
msgstr "Filtrovať koncepty…"

#, kde-format
msgid "Finish the current KMyMoney operation first."
msgstr "Najprv dokončite aktuálnu operáciu v KMyMoney."

#, kde-format
msgid "Frozen"
msgstr "Zmrazené"

#, kde-format
msgid "Invalid archived transaction identity or date."
msgstr "Neplatný identifikátor alebo dátum archivovanej transakcie."

#, kde-format
msgid "Invalid draft identity or timestamp."
msgstr "Neplatný identifikátor alebo časová pečiatka konceptu."

#, kde-format
msgid "Invalid draft split."
msgstr "Neplatné rozdelenie konceptu."

#, kde-format
msgid "Invalid draft tag."
msgstr "Neplatná značka konceptu."

#, kde-format
msgid "Invalid exact monetary value in draft."
msgstr "Neplatná presná peňažná hodnota v koncepte."

#, kde-format
msgid "Invalid matched transaction."
msgstr "Neplatná spárovaná transakcia."

#, kde-format
msgid "Invalid reconciliation state."
msgstr "Neplatný stav odsúhlasenia."

#, kde-format
msgid "Invalid restoration recovery record."
msgstr "Neplatný záchranný záznam obnovenia."

#, kde-format
msgid "KMyMoney changed transaction fields during restoration. The operation was rolled back and the draft was retained."
msgstr "KMyMoney počas obnovenia zmenil polia transakcie. Operácia sa vrátila späť a koncept sa zachoval."

#, kde-format
msgid "Keep complete transactions in drafts and restore them later"
msgstr "Uchovávajte celé transakcie v konceptoch a obnovte ich neskôr"

#, kde-format
msgid "Matched transaction nesting is too deep."
msgstr "Spárované transakcie sú vnorené príliš hlboko."

#, kde-format
msgid "Memo"
msgstr "Poznámka"

#, kde-format
msgid "Missing or duplicate split identity in draft."
msgstr "Chýbajúci alebo duplicitný identifikátor rozdelenia v koncepte."

#, kde-format
msgid "Move the complete selected transactions, including every split, to drafts? They will stop affecting all account balances, reports, and reconciliations."
msgstr "Presunúť celé vybrané transakcie vrátane všetkých rozdelení do konceptov? Prestanú ovplyvňovať zostatky všetkých účtov, výkazy a odsúhlasenia."

#, kde-format
msgid "Move to drafts"
msgstr "Presunúť do konceptov"

#, kde-format
msgid "Moving or restoring reconciled transactions changes historical balances. If you change the posting date, review the affected reconciliations afterwards."
msgstr "Presun alebo obnovenie odsúhlasených transakcií mení historické zostatky. Ak zmeníte dátum zaúčtovania, potom skontrolujte dotknuté odsúhlasenia."

#, kde-format
msgid "No draft transactions in this document."
msgstr "V tomto dokumente nie sú žiadne koncepty transakcií."

#, kde-format
msgid "Not reconciled"
msgstr "Neodsúhlasené"

#, kde-format
msgid "Open a KMyMoney document to view its drafts."
msgstr "Otvorte dokument KMyMoney a zobrazte jeho koncepty."

#, kde-format
msgid "Payee"
msgstr "Príjemca"

#, kde-format
msgid "Posting date:"
msgstr "Dátum zaúčtovania:"

#, kde-format
msgid "Price (exact)"
msgstr "Cena (presná)"

#, kde-format
msgid "Reconciled"
msgstr "Odsúhlasené"

#, kde-format
msgid "Reconciliation"
msgstr "Odsúhlasenie"

#, kde-format
msgid "Reconciliation date"
msgstr "Dátum odsúhlasenia"

#, kde-format
msgid "Remove saved restoration copies"
msgstr "Odstrániť kópie uložených obnovení"

#, kde-format
msgid "Restoration requires a valid posting date and no other active operation."
msgstr "Obnovenie vyžaduje platný dátum zaúčtovania a žiadnu inú aktívnu operáciu."

#, kde-format
msgid "Restore"
msgstr "Obnoviť"

#, kde-format
msgid "Restore draft transaction"
msgstr "Obnoviť koncept transakcie"

#, kde-format
msgid "Restored; recovery copy retained"
msgstr "Obnovené; záchranná kópia zachovaná"

#, kde-format
msgid "Select at least one saved transaction."
msgstr "Vyberte aspoň jednu uloženú transakciu."

#, kde-format
msgid "Shares (exact)"
msgstr "Podiely (presne)"

#, kde-format
msgid "Show drafts…"
msgstr "Zobraziť koncepty…"

#, kde-format
msgid "Splits"
msgstr "Rozdelenia"

#, kde-format
msgid "Status"
msgstr "Stav"

#, kde-format
msgid "The plugin module could not be retained for undo history. Restart KMyMoney and check the plugin installation."
msgstr "Modul doplnku sa nepodarilo zachovať pre históriu vrátenia zmien. Reštartujte KMyMoney a skontrolujte inštaláciu doplnku."

#, kde-format
msgid "The selected ledger split no longer exists."
msgstr "Vybrané rozdelenie v účtovnej knihe už neexistuje."

#, kde-format
msgid "The transaction currency or security no longer exists."
msgstr "Mena alebo cenný papier transakcie už neexistuje."

#, kde-format
msgid "This draft exceeds the 4 MiB metadata record limit."
msgstr "Tento koncept prekračuje limit 4 MiB na záznam metadát."

#, kde-format
msgid "This draft has already been restored. Save the document to finish cleanup."
msgstr "Tento koncept už bol obnovený. Uložte dokument, aby sa dokončilo odstránenie kópie."

#, kde-format
msgid "This draft no longer exists."
msgstr "Tento koncept už neexistuje."

#, kde-format
msgid "This transaction already has a draft or a pending restoration record. Save the document first."
msgstr "Táto transakcia už má koncept alebo čakajúci záznam obnovenia. Najprv uložte dokument."

#, kde-format
msgid "This transaction cannot be archived without changes."
msgstr "Túto transakciu nemožno archivovať bez zmien."

#, kde-format
msgid "Unable to move to drafts"
msgstr "Nemožno presunúť do konceptov"

#, kde-format
msgid "Unable to read drafts: %1"
msgstr "Nemožno načítať koncepty: %1"

#, kde-format
msgid "Unable to restore draft"
msgstr "Nemožno obnoviť koncept"

#, kde-format
msgid "Unknown"
msgstr "Neznáme"

#, kde-format
msgid "Unknown or missing draft fields. Archive left unchanged."
msgstr "Neznáme alebo chýbajúce polia konceptu. Archív zostal nezmenený."

#, kde-format
msgid "Unsupported draft metadata version. Update the plugin before changing drafts."
msgstr "Nepodporovaná verzia metadát konceptu. Pred zmenou konceptov aktualizujte doplnok."

#, kde-format
msgid "Value"
msgstr "Hodnota"

#, kde-format
msgid "Value (%1)"
msgstr "Hodnota (%1)"
