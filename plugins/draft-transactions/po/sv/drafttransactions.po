#, kde-format
msgid "A split references a missing cost center: %1"
msgstr "En delning hänvisar till ett kostnadsställe som saknas: %1"

#, kde-format
msgid "A split references a missing or standard account: %1"
msgstr "En delning hänvisar till ett konto som saknas eller ett standardkonto: %1"

#, kde-format
msgid "A split references a missing payee: %1"
msgstr "En delning hänvisar till en betalningsmottagare som saknas: %1"

#, kde-format
msgid "A split references a missing tag: %1"
msgstr "En delning hänvisar till en etikett som saknas: %1"

#, kde-format
msgid "Account"
msgstr "Konto"

#, kde-format
msgid "Account '%1' is closed. Reopen it in KMyMoney before moving or restoring this transaction."
msgstr "Kontot '%1' är stängt. Öppna det igen i KMyMoney innan transaktionen flyttas eller återställs."

#, kde-format
msgid "All splits (read-only; exact amounts are shown as fractions)"
msgstr "Alla delningar (skrivskyddade; exakta belopp visas som bråk)"

#, kde-format
msgid "Cleared"
msgstr "Kontrollerad"

#, kde-format
msgid "Currency"
msgstr "Valuta"

#, kde-format
msgid "Date"
msgstr "Datum"

#, kde-format
msgid "Draft"
msgstr "Utkast"

#, kde-format
msgid "Draft checksum mismatch. The archive was not changed."
msgstr "Utkastets kontrollsumma stämmer inte. Arkivet ändrades inte."

#, kde-format
msgid "Draft contains missing, unknown, or noncanonical transaction fields."
msgstr "Utkastet innehåller saknade, okända eller icke-kanoniska transaktionsfält."

#, kde-format
msgid "Draft identity does not match its metadata key. No drafts were changed."
msgstr "Utkastets identitet stämmer inte med metadatanyckeln. Inga utkast ändrades."

#, kde-format
msgid "Draft metadata is not valid JSON."
msgstr "Utkastets metadata är inte giltig JSON."

#, kde-format
msgid "Draft metadata is too large."
msgstr "Utkastets metadata är för stora."

#, kde-format
msgid "Draft metadata must be an object."
msgstr "Utkastets metadata måste vara ett objekt."

#, kde-format
msgid "Draft metadata values must be strings."
msgstr "Utkastets metadatavärden måste vara strängar."

#, kde-format
msgid "Draft origin split does not exist."
msgstr "Utkastets ursprungliga delning finns inte."

#, kde-format
msgid "Draft splits are missing."
msgstr "Utkastets delningar saknas."

#, kde-format
msgid "Draft tags are missing."
msgstr "Utkastets etiketter saknas."

#, kde-format
msgid "Draft transactions"
msgstr "Transaktionsutkast"

#, kde-format
msgid "Drafted (UTC)"
msgstr "Flyttad till utkast (UTC)"

#, kde-format
msgid "Drafts"
msgstr "Utkast"

#, kde-format
msgid "Drafts do not affect balances. Save the document to keep changes. Restored recovery copies are removed only after a clean save and full verification; cleanup is saved with the next document save."
msgstr "Utkast påverkar inte saldon. Spara dokumentet för att behålla ändringarna. Återställningskopior av återställda transaktioner tas bort först efter en lyckad lagring och fullständig kontroll; rensningen sparas nästa gång dokumentet sparas."

#, kde-format
msgid "Every split will return to its original account. Only the posting date can change; reconciliation flags and dates remain unchanged."
msgstr "Varje delning återgår till sitt ursprungliga konto. Endast bokföringsdatumet kan ändras; avstämningsmarkeringar och datum förblir oförändrade."

#, kde-format
msgid "Filter drafts…"
msgstr "Filtrera utkast…"

#, kde-format
msgid "Finish the current KMyMoney operation first."
msgstr "Avsluta först den pågående åtgärden i KMyMoney."

#, kde-format
msgid "Frozen"
msgstr "Fryst"

#, kde-format
msgid "Invalid archived transaction identity or date."
msgstr "Ogiltig identitet eller ogiltigt datum för den arkiverade transaktionen."

#, kde-format
msgid "Invalid draft identity or timestamp."
msgstr "Ogiltig utkastidentitet eller tidsstämpel."

#, kde-format
msgid "Invalid draft split."
msgstr "Ogiltig delning i utkastet."

#, kde-format
msgid "Invalid draft tag."
msgstr "Ogiltig etikett i utkastet."

#, kde-format
msgid "Invalid exact monetary value in draft."
msgstr "Ogiltigt exakt penningvärde i utkastet."

#, kde-format
msgid "Invalid matched transaction."
msgstr "Ogiltig matchad transaktion."

#, kde-format
msgid "Invalid reconciliation state."
msgstr "Ogiltigt avstämningstillstånd."

#, kde-format
msgid "Invalid restoration recovery record."
msgstr "Ogiltig återställningspost."

#, kde-format
msgid "KMyMoney changed transaction fields during restoration. The operation was rolled back and the draft was retained."
msgstr "KMyMoney ändrade transaktionsfält under återställningen. Åtgärden återställdes och utkastet behölls."

#, kde-format
msgid "Keep complete transactions in drafts and restore them later"
msgstr "Behåll fullständiga transaktioner som utkast och återställ dem senare"

#, kde-format
msgid "Matched transaction nesting is too deep."
msgstr "Matchade transaktioner är nästlade för djupt."

#, kde-format
msgid "Memo"
msgstr "Anteckning"

#, kde-format
msgid "Missing or duplicate split identity in draft."
msgstr "Delningsidentitet saknas eller är dubblerad i utkastet."

#, kde-format
msgid "Move the complete selected transactions, including every split, to drafts? They will stop affecting all account balances, reports, and reconciliations."
msgstr "Flytta de valda transaktionerna i sin helhet, inklusive alla delningar, till utkast? De kommer inte längre att påverka kontosaldon, rapporter och avstämningar."

#, kde-format
msgid "Move to drafts"
msgstr "Flytta till utkast"

#, kde-format
msgid "Moving or restoring reconciled transactions changes historical balances. If you change the posting date, review the affected reconciliations afterwards."
msgstr "Flytt eller återställning av avstämda transaktioner ändrar historiska saldon. Om bokföringsdatumet ändras bör berörda avstämningar granskas efteråt."

#, kde-format
msgid "No draft transactions in this document."
msgstr "Inga transaktionsutkast i dokumentet."

#, kde-format
msgid "Not reconciled"
msgstr "Inte avstämd"

#, kde-format
msgid "Open a KMyMoney document to view its drafts."
msgstr "Öppna ett KMyMoney-dokument för att visa dess utkast."

#, kde-format
msgid "Payee"
msgstr "Betalningsmottagare"

#, kde-format
msgid "Posting date:"
msgstr "Bokföringsdatum:"

#, kde-format
msgid "Price (exact)"
msgstr "Pris (exakt)"

#, kde-format
msgid "Reconciled"
msgstr "Avstämd"

#, kde-format
msgid "Reconciliation"
msgstr "Avstämning"

#, kde-format
msgid "Reconciliation date"
msgstr "Avstämningsdatum"

#, kde-format
msgid "Remove saved restoration copies"
msgstr "Ta bort kopior av sparade återställningar"

#, kde-format
msgid "Restoration requires a valid posting date and no other active operation."
msgstr "Återställning kräver ett giltigt bokföringsdatum och att ingen annan åtgärd pågår."

#, kde-format
msgid "Restore"
msgstr "Återställ"

#, kde-format
msgid "Restore draft transaction"
msgstr "Återställ transaktionsutkast"

#, kde-format
msgid "Restored; recovery copy retained"
msgstr "Återställd; återställningskopia behållen"

#, kde-format
msgid "Select at least one saved transaction."
msgstr "Välj minst en sparad transaktion."

#, kde-format
msgid "Shares (exact)"
msgstr "Aktier (exakt)"

#, kde-format
msgid "Show drafts…"
msgstr "Visa utkast…"

#, kde-format
msgid "Splits"
msgstr "Delningar"

#, kde-format
msgid "Status"
msgstr "Status"

#, kde-format
msgid "The plugin module could not be retained for undo history. Restart KMyMoney and check the plugin installation."
msgstr "Insticksmodulen kunde inte behållas för ångringshistoriken. Starta om KMyMoney och kontrollera insticksmodulens installation."

#, kde-format
msgid "The selected ledger split no longer exists."
msgstr "Den valda delningen i huvudboken finns inte längre."

#, kde-format
msgid "The transaction currency or security no longer exists."
msgstr "Transaktionens valuta eller värdepapper finns inte längre."

#, kde-format
msgid "This draft exceeds the 4 MiB metadata record limit."
msgstr "Utkastet överskrider gränsen på 4 MiB per metadatapost."

#, kde-format
msgid "This draft has already been restored. Save the document to finish cleanup."
msgstr "Utkastet har redan återställts. Spara dokumentet för att slutföra rensningen."

#, kde-format
msgid "This draft no longer exists."
msgstr "Utkastet finns inte längre."

#, kde-format
msgid "This transaction already has a draft or a pending restoration record. Save the document first."
msgstr "Transaktionen har redan ett utkast eller en väntande återställningspost. Spara dokumentet först."

#, kde-format
msgid "This transaction cannot be archived without changes."
msgstr "Transaktionen kan inte arkiveras utan ändringar."

#, kde-format
msgid "Unable to move to drafts"
msgstr "Kan inte flytta till utkast"

#, kde-format
msgid "Unable to read drafts: %1"
msgstr "Kan inte läsa utkast: %1"

#, kde-format
msgid "Unable to restore draft"
msgstr "Kan inte återställa utkast"

#, kde-format
msgid "Unknown"
msgstr "Okänd"

#, kde-format
msgid "Unknown or missing draft fields. Archive left unchanged."
msgstr "Okända eller saknade utkastfält. Arkivet är oförändrat."

#, kde-format
msgid "Unsupported draft metadata version. Update the plugin before changing drafts."
msgstr "Versionen av utkastmetadata stöds inte. Uppdatera insticksmodulen innan utkast ändras."

#, kde-format
msgid "Value"
msgstr "Värde"

#, kde-format
msgid "Value (%1)"
msgstr "Värde (%1)"
