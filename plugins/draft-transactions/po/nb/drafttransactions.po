#, kde-format
msgid "A split references a missing cost center: %1"
msgstr "En oppdeling viser til et manglende kostnadssted: %1"

#, kde-format
msgid "A split references a missing or standard account: %1"
msgstr "En oppdeling viser til en manglende konto eller en standardkonto: %1"

#, kde-format
msgid "A split references a missing payee: %1"
msgstr "En oppdeling viser til en manglende betalingsmottaker: %1"

#, kde-format
msgid "A split references a missing tag: %1"
msgstr "En oppdeling viser til en manglende etikett: %1"

#, kde-format
msgid "Account"
msgstr "Konto"

#, kde-format
msgid "Account '%1' is closed. Reopen it in KMyMoney before moving or restoring this transaction."
msgstr "Kontoen «%1» er stengt. Åpne den igjen i KMyMoney før transaksjonen flyttes eller gjenopprettes."

#, kde-format
msgid "Cleared"
msgstr "Kontrollert"

#, kde-format
msgid "Currency"
msgstr "Valuta"

#, kde-format
msgid "Date"
msgstr "Dato"

#, kde-format
msgid "Draft"
msgstr "Kladd"

#, kde-format
msgid "Draft checksum mismatch. The archive was not changed."
msgstr "Kladdens kontrollsum stemmer ikke. Arkivet ble ikke endret."

#, kde-format
msgid "Draft contains missing, unknown, or noncanonical transaction fields."
msgstr "Kladden inneholder manglende, ukjente eller ikke-kanoniske transaksjonsfelt."

#, kde-format
msgid "Draft identity does not match its metadata key. No drafts were changed."
msgstr "Kladdens identitet stemmer ikke med metadatanøkkelen. Ingen kladder ble endret."

#, kde-format
msgid "Draft metadata is not valid JSON."
msgstr "Kladdens metadata er ikke gyldig JSON."

#, kde-format
msgid "Draft metadata is too large."
msgstr "Kladdens metadata er for store."

#, kde-format
msgid "Draft metadata must be an object."
msgstr "Kladdens metadata må være et objekt."

#, kde-format
msgid "Draft metadata values must be strings."
msgstr "Kladdens metadataverdier må være strenger."

#, kde-format
msgid "Draft origin split does not exist."
msgstr "Kladdens opprinnelige oppdeling finnes ikke."

#, kde-format
msgid "Draft splits are missing."
msgstr "Kladdens oppdelinger mangler."

#, kde-format
msgid "Draft tags are missing."
msgstr "Kladdens etiketter mangler."

#, kde-format
msgid "Draft transactions"
msgstr "Kladdetransaksjoner"

#, kde-format
msgid "Drafted (UTC)"
msgstr "Flyttet til kladd (UTC)"

#, kde-format
msgid "Drafts"
msgstr "Kladder"

#, kde-format
msgid "Drafts do not affect balances. Save the document to keep changes. Restored recovery copies are removed only after a clean save and full verification; cleanup is saved with the next document save."
msgstr "Kladder påvirker ikke saldoer. Lagre dokumentet for å beholde endringene. Gjenopprettingskopier av gjenopprettede transaksjoner fjernes først etter vellykket lagring og full kontroll; oppryddingen lagres neste gang dokumentet lagres."

#, kde-format
msgid "Every split will return to its original account. Only the posting date can change; reconciliation flags and dates remain unchanged."
msgstr "Hver oppdeling går tilbake til sin opprinnelige konto. Bare bokføringsdatoen kan endres; avstemmingsmarkeringer og datoer forblir uendret."

#, kde-format
msgid "Filter drafts…"
msgstr "Filtrer kladder…"

#, kde-format
msgid "Finish the current KMyMoney operation first."
msgstr "Fullfør først den pågående handlingen i KMyMoney."

#, kde-format
msgid "Frozen"
msgstr "Frosset"

#, kde-format
msgid "Invalid archived transaction identity or date."
msgstr "Ugyldig identitet eller dato for den arkiverte transaksjonen."

#, kde-format
msgid "Invalid draft identity or timestamp."
msgstr "Ugyldig kladdidentitet eller tidsstempel."

#, kde-format
msgid "Invalid draft split."
msgstr "Ugyldig oppdeling i kladden."

#, kde-format
msgid "Invalid draft tag."
msgstr "Ugyldig etikett i kladden."

#, kde-format
msgid "Invalid exact monetary value in draft."
msgstr "Ugyldig nøyaktig pengeverdi i kladden."

#, kde-format
msgid "Invalid matched transaction."
msgstr "Ugyldig samsvarende transaksjon."

#, kde-format
msgid "Invalid reconciliation state."
msgstr "Ugyldig avstemmingstilstand."

#, kde-format
msgid "Invalid restoration recovery record."
msgstr "Ugyldig gjenopprettingspost."

#, kde-format
msgid "KMyMoney changed transaction fields during restoration. The operation was rolled back and the draft was retained."
msgstr "KMyMoney endret transaksjonsfelt under gjenopprettingen. Handlingen ble rullet tilbake, og kladden ble beholdt."

#, kde-format
msgid "Keep complete transactions in drafts and restore them later"
msgstr "Behold hele transaksjoner i kladder og gjenopprett dem senere"

#, kde-format
msgid "Matched transaction nesting is too deep."
msgstr "Samsvarende transaksjoner er nestet for dypt."

#, kde-format
msgid "Memo"
msgstr "Notat"

#, kde-format
msgid "Missing or duplicate split identity in draft."
msgstr "Manglende eller duplisert oppdelingsidentitet i kladden."

#, kde-format
msgid "Move the complete selected transactions, including every split, to drafts? They will stop affecting all account balances, reports, and reconciliations."
msgstr "Flytte de valgte transaksjonene i sin helhet, inkludert alle oppdelinger, til kladder? De vil ikke lenger påvirke kontosaldoer, rapporter og avstemminger."

#, kde-format
msgid "Move to drafts"
msgstr "Flytt til kladder"

#, kde-format
msgid "Moving or restoring reconciled transactions changes historical balances. If you change the posting date, review the affected reconciliations afterwards."
msgstr "Flytting eller gjenoppretting av avstemte transaksjoner endrer historiske saldoer. Hvis bokføringsdatoen endres, bør berørte avstemminger gjennomgås etterpå."

#, kde-format
msgid "No draft transactions in this document."
msgstr "Ingen kladdetransaksjoner i dette dokumentet."

#, kde-format
msgid "Not reconciled"
msgstr "Ikke avstemt"

#, kde-format
msgid "Open a KMyMoney document to view its drafts."
msgstr "Åpne et KMyMoney-dokument for å se kladdene i det."

#, kde-format
msgid "Payee"
msgstr "Betalingsmottaker"

#, kde-format
msgid "Posting date:"
msgstr "Bokføringsdato:"

#, kde-format
msgid "Price (exact)"
msgstr "Pris (nøyaktig)"

#, kde-format
msgid "Reconciled"
msgstr "Avstemt"

#, kde-format
msgid "Reconciliation"
msgstr "Avstemming"

#, kde-format
msgid "Reconciliation date"
msgstr "Avstemmingsdato"

#, kde-format
msgid "Remove saved restoration copies"
msgstr "Fjern kopier av lagrede gjenopprettinger"

#, kde-format
msgid "Restoration requires a valid posting date and no other active operation."
msgstr "Gjenoppretting krever en gyldig bokføringsdato og at ingen annen handling pågår."

#, kde-format
msgid "Restore"
msgstr "Gjenopprett"

#, kde-format
msgid "Restore draft transaction"
msgstr "Gjenopprett kladdetransaksjon"

#, kde-format
msgid "Restored; recovery copy retained"
msgstr "Gjenopprettet; gjenopprettingskopi beholdt"

#, kde-format
msgid "Select at least one saved transaction."
msgstr "Velg minst én lagret transaksjon."

#, kde-format
msgid "Shares (exact)"
msgstr "Aksjer (nøyaktig)"

#, kde-format
msgid "Show drafts…"
msgstr "Vis kladder…"

#, kde-format
msgid "Splits"
msgstr "Oppdelinger"

#, kde-format
msgid "Status"
msgstr "Status"

#, kde-format
msgid "The plugin module could not be retained for undo history. Restart KMyMoney and check the plugin installation."
msgstr "Programtillegget kunne ikke beholdes for angrehistorikken. Start KMyMoney på nytt og kontroller installasjonen av tillegget."

#, kde-format
msgid "The selected ledger split no longer exists."
msgstr "Den valgte oppdelingen i hovedboken finnes ikke lenger."

#, kde-format
msgid "The transaction currency or security no longer exists."
msgstr "Transaksjonens valuta eller verdipapir finnes ikke lenger."

#, kde-format
msgid "This draft exceeds the 4 MiB metadata record limit."
msgstr "Denne kladden overskrider grensen på 4 MiB per metadatapost."

#, kde-format
msgid "This draft has already been restored. Save the document to finish cleanup."
msgstr "Denne kladden er allerede gjenopprettet. Lagre dokumentet for å fullføre oppryddingen."

#, kde-format
msgid "This draft no longer exists."
msgstr "Denne kladden finnes ikke lenger."

#, kde-format
msgid "This transaction already has a draft or a pending restoration record. Save the document first."
msgstr "Denne transaksjonen har allerede en kladd eller en ventende gjenopprettingspost. Lagre dokumentet først."

#, kde-format
msgid "This transaction cannot be archived without changes."
msgstr "Denne transaksjonen kan ikke arkiveres uten endringer."

#, kde-format
msgid "Unable to move to drafts"
msgstr "Kan ikke flytte til kladder"

#, kde-format
msgid "Unable to read drafts: %1"
msgstr "Kan ikke lese kladder: %1"

#, kde-format
msgid "Unable to restore draft"
msgstr "Kan ikke gjenopprette kladd"

#, kde-format
msgid "Unknown"
msgstr "Ukjent"

#, kde-format
msgid "Unknown or missing draft fields. Archive left unchanged."
msgstr "Ukjente eller manglende kladdfelt. Arkivet er uendret."

#, kde-format
msgid "Unsupported draft metadata version. Update the plugin before changing drafts."
msgstr "Versjonen av kladdmetadata støttes ikke. Oppdater tillegget før kladder endres."

#, kde-format
msgid "Value"
msgstr "Verdi"

#, kde-format
msgid "Value (%1)"
msgstr "Verdi (%1)"

#, kde-format
#~ msgid "All splits (read-only; exact amounts are shown as fractions)"
#~ msgstr "Alle oppdelinger (skrivebeskyttet; nøyaktige beløp vises som brøker)"
