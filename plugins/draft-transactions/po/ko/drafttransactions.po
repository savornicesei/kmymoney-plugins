#, kde-format
msgid "A split references a missing cost center: %1"
msgstr "분할이 없는 비용 센터를 참조합니다: %1"

#, kde-format
msgid "A split references a missing or standard account: %1"
msgstr "분할이 없거나 표준 계좌인 계좌를 참조합니다: %1"

#, kde-format
msgid "A split references a missing payee: %1"
msgstr "분할이 없는 수취인을 참조합니다: %1"

#, kde-format
msgid "A split references a missing tag: %1"
msgstr "분할이 없는 태그를 참조합니다: %1"

#, kde-format
msgid "Account"
msgstr "계좌"

#, kde-format
msgid "Account '%1' is closed. Reopen it in KMyMoney before moving or restoring this transaction."
msgstr "계좌 '%1'이(가) 폐쇄되었습니다. 이 거래를 이동하거나 복원하기 전에 KMyMoney에서 다시 여십시오."

#, kde-format
msgid "All splits (read-only; exact amounts are shown as fractions)"
msgstr "모든 분할(읽기 전용, 정확한 금액은 분수로 표시)"

#, kde-format
msgid "Cleared"
msgstr "확인됨"

#, kde-format
msgid "Currency"
msgstr "통화"

#, kde-format
msgid "Date"
msgstr "날짜"

#, kde-format
msgid "Draft"
msgstr "초안"

#, kde-format
msgid "Draft checksum mismatch. The archive was not changed."
msgstr "초안 체크섬이 일치하지 않습니다. 보관 자료는 변경되지 않았습니다."

#, kde-format
msgid "Draft contains missing, unknown, or noncanonical transaction fields."
msgstr "초안의 거래 필드가 없거나 알 수 없거나 정규 형식이 아닙니다."

#, kde-format
msgid "Draft identity does not match its metadata key. No drafts were changed."
msgstr "초안 식별자가 메타데이터 키와 일치하지 않습니다. 초안은 변경되지 않았습니다."

#, kde-format
msgid "Draft metadata is not valid JSON."
msgstr "초안 메타데이터가 올바른 JSON이 아닙니다."

#, kde-format
msgid "Draft metadata is too large."
msgstr "초안 메타데이터가 너무 큽니다."

#, kde-format
msgid "Draft metadata must be an object."
msgstr "초안 메타데이터는 객체여야 합니다."

#, kde-format
msgid "Draft metadata values must be strings."
msgstr "초안 메타데이터 값은 문자열이어야 합니다."

#, kde-format
msgid "Draft origin split does not exist."
msgstr "초안의 원래 분할이 없습니다."

#, kde-format
msgid "Draft splits are missing."
msgstr "초안 분할이 없습니다."

#, kde-format
msgid "Draft tags are missing."
msgstr "초안 태그가 없습니다."

#, kde-format
msgid "Draft transactions"
msgstr "거래 초안"

#, kde-format
msgid "Drafted (UTC)"
msgstr "초안으로 이동한 시각(UTC)"

#, kde-format
msgid "Drafts"
msgstr "초안"

#, kde-format
msgid "Drafts do not affect balances. Save the document to keep changes. Restored recovery copies are removed only after a clean save and full verification; cleanup is saved with the next document save."
msgstr "초안은 잔액에 영향을 주지 않습니다. 변경 사항을 유지하려면 문서를 저장하십시오. 복원된 거래의 복구용 사본은 저장과 전체 검증이 성공한 후에만 삭제됩니다. 이 정리 작업은 다음 문서 저장 시 저장됩니다."

#, kde-format
msgid "Every split will return to its original account. Only the posting date can change; reconciliation flags and dates remain unchanged."
msgstr "각 분할은 원래 계좌로 돌아갑니다. 기장일만 변경할 수 있으며 조정 표시와 날짜는 변경되지 않습니다."

#, kde-format
msgid "Filter drafts…"
msgstr "초안 필터…"

#, kde-format
msgid "Finish the current KMyMoney operation first."
msgstr "현재 KMyMoney 작업을 먼저 완료하십시오."

#, kde-format
msgid "Frozen"
msgstr "동결됨"

#, kde-format
msgid "Invalid archived transaction identity or date."
msgstr "보관된 거래의 식별자 또는 날짜가 잘못되었습니다."

#, kde-format
msgid "Invalid draft identity or timestamp."
msgstr "초안 식별자 또는 타임스탬프가 잘못되었습니다."

#, kde-format
msgid "Invalid draft split."
msgstr "초안 분할이 잘못되었습니다."

#, kde-format
msgid "Invalid draft tag."
msgstr "초안 태그가 잘못되었습니다."

#, kde-format
msgid "Invalid exact monetary value in draft."
msgstr "초안의 정확한 금액 값이 잘못되었습니다."

#, kde-format
msgid "Invalid matched transaction."
msgstr "일치시킨 거래가 잘못되었습니다."

#, kde-format
msgid "Invalid reconciliation state."
msgstr "조정 상태가 잘못되었습니다."

#, kde-format
msgid "Invalid restoration recovery record."
msgstr "복원 복구 기록이 잘못되었습니다."

#, kde-format
msgid "KMyMoney changed transaction fields during restoration. The operation was rolled back and the draft was retained."
msgstr "복원 중 KMyMoney가 거래 필드를 변경했습니다. 작업이 롤백되었으며 초안은 유지되었습니다."

#, kde-format
msgid "Keep complete transactions in drafts and restore them later"
msgstr "거래 전체를 초안으로 보관하고 나중에 복원합니다"

#, kde-format
msgid "Matched transaction nesting is too deep."
msgstr "일치시킨 거래의 중첩 단계가 너무 깊습니다."

#, kde-format
msgid "Memo"
msgstr "메모"

#, kde-format
msgid "Missing or duplicate split identity in draft."
msgstr "초안의 분할 식별자가 없거나 중복되었습니다."

#, kde-format
msgid "Move the complete selected transactions, including every split, to drafts? They will stop affecting all account balances, reports, and reconciliations."
msgstr "선택한 거래 전체를 모든 분할과 함께 초안으로 이동하시겠습니까? 이 거래는 더 이상 모든 계좌 잔액, 보고서 및 조정에 영향을 주지 않습니다."

#, kde-format
msgid "Move to drafts"
msgstr "초안으로 이동"

#, kde-format
msgid "Moving or restoring reconciled transactions changes historical balances. If you change the posting date, review the affected reconciliations afterwards."
msgstr "조정된 거래를 이동하거나 복원하면 과거 잔액이 변경됩니다. 기장일을 변경하면 나중에 영향을 받는 조정을 검토하십시오."

#, kde-format
msgid "No draft transactions in this document."
msgstr "이 문서에 거래 초안이 없습니다."

#, kde-format
msgid "Not reconciled"
msgstr "조정되지 않음"

#, kde-format
msgid "Open a KMyMoney document to view its drafts."
msgstr "초안을 보려면 KMyMoney 문서를 여십시오."

#, kde-format
msgid "Payee"
msgstr "수취인"

#, kde-format
msgid "Posting date:"
msgstr "기장일:"

#, kde-format
msgid "Price (exact)"
msgstr "가격(정확한 값)"

#, kde-format
msgid "Reconciled"
msgstr "조정됨"

#, kde-format
msgid "Reconciliation"
msgstr "조정"

#, kde-format
msgid "Reconciliation date"
msgstr "조정 날짜"

#, kde-format
msgid "Remove saved restoration copies"
msgstr "저장된 복원의 사본 삭제"

#, kde-format
msgid "Restoration requires a valid posting date and no other active operation."
msgstr "복원하려면 유효한 기장일이 필요하며 다른 작업이 진행 중이면 안 됩니다."

#, kde-format
msgid "Restore"
msgstr "복원"

#, kde-format
msgid "Restore draft transaction"
msgstr "거래 초안 복원"

#, kde-format
msgid "Restored; recovery copy retained"
msgstr "복원됨, 복구용 사본 유지됨"

#, kde-format
msgid "Select at least one saved transaction."
msgstr "저장된 거래를 하나 이상 선택하십시오."

#, kde-format
msgid "Shares (exact)"
msgstr "주식 수(정확한 값)"

#, kde-format
msgid "Show drafts…"
msgstr "초안 표시…"

#, kde-format
msgid "Splits"
msgstr "분할"

#, kde-format
msgid "Status"
msgstr "상태"

#, kde-format
msgid "The plugin module could not be retained for undo history. Restart KMyMoney and check the plugin installation."
msgstr "실행 취소 기록을 위해 플러그인 모듈을 유지할 수 없습니다. KMyMoney를 다시 시작하고 플러그인 설치를 확인하십시오."

#, kde-format
msgid "The selected ledger split no longer exists."
msgstr "선택한 원장 분할이 더 이상 없습니다."

#, kde-format
msgid "The transaction currency or security no longer exists."
msgstr "거래의 통화 또는 유가 증권이 더 이상 없습니다."

#, kde-format
msgid "This draft exceeds the 4 MiB metadata record limit."
msgstr "이 초안은 메타데이터 기록의 4 MiB 제한을 초과합니다."

#, kde-format
msgid "This draft has already been restored. Save the document to finish cleanup."
msgstr "이 초안은 이미 복원되었습니다. 정리를 완료하려면 문서를 저장하십시오."

#, kde-format
msgid "This draft no longer exists."
msgstr "이 초안은 더 이상 없습니다."

#, kde-format
msgid "This transaction already has a draft or a pending restoration record. Save the document first."
msgstr "이 거래에는 이미 초안 또는 보류 중인 복원 기록이 있습니다. 먼저 문서를 저장하십시오."

#, kde-format
msgid "This transaction cannot be archived without changes."
msgstr "이 거래는 변경 없이 보관할 수 없습니다."

#, kde-format
msgid "Unable to move to drafts"
msgstr "초안으로 이동할 수 없음"

#, kde-format
msgid "Unable to read drafts: %1"
msgstr "초안을 읽을 수 없음: %1"

#, kde-format
msgid "Unable to restore draft"
msgstr "초안을 복원할 수 없음"

#, kde-format
msgid "Unknown"
msgstr "알 수 없음"

#, kde-format
msgid "Unknown or missing draft fields. Archive left unchanged."
msgstr "초안 필드가 없거나 알 수 없습니다. 보관 자료는 변경되지 않았습니다."

#, kde-format
msgid "Unsupported draft metadata version. Update the plugin before changing drafts."
msgstr "지원하지 않는 초안 메타데이터 버전입니다. 초안을 변경하기 전에 플러그인을 업데이트하십시오."

#, kde-format
msgid "Value"
msgstr "금액"

#, kde-format
msgid "Value (%1)"
msgstr "금액(%1)"
