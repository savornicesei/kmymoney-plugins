#, kde-format
msgid "A split references a missing cost center: %1"
msgstr "Disigo referencas mankantan kostocentron: %1"

#, kde-format
msgid "A split references a missing or standard account: %1"
msgstr "Disigo referencas mankantan aŭ norman konton: %1"

#, kde-format
msgid "A split references a missing payee: %1"
msgstr "Disigo referencas mankantan pagaton: %1"

#, kde-format
msgid "A split references a missing tag: %1"
msgstr "Disigo referencas mankantan etikedon: %1"

#, kde-format
msgid "Account"
msgstr "Konto"

#, kde-format
msgid "Account '%1' is closed. Reopen it in KMyMoney before moving or restoring this transaction."
msgstr "Konto '%1' estas fermita. Remalfermu ĝin en KMyMoney antaŭ ol movi aŭ restarigi ĉi tiun transakcion."

#, kde-format
msgid "All splits (read-only; exact amounts are shown as fractions)"
msgstr "Ĉiuj disigoj (nurlege; ekzaktaj sumoj estas montrataj kiel frakcioj)"

#, kde-format
msgid "Cleared"
msgstr "Kontrolita"

#, kde-format
msgid "Currency"
msgstr "Valuto"

#, kde-format
msgid "Date"
msgstr "Dato"

#, kde-format
msgid "Draft"
msgstr "Malneto"

#, kde-format
msgid "Draft checksum mismatch. The archive was not changed."
msgstr "La kontrolsumo de la malneto ne kongruas. La arkivo ne estis ŝanĝita."

#, kde-format
msgid "Draft contains missing, unknown, or noncanonical transaction fields."
msgstr "La malneto enhavas mankantajn, nekonatajn aŭ nekanonajn transakciajn kampojn."

#, kde-format
msgid "Draft identity does not match its metadata key. No drafts were changed."
msgstr "La identigilo de la malneto ne kongruas kun ĝia metadatuma ŝlosilo. Neniu malneto estis ŝanĝita."

#, kde-format
msgid "Draft metadata is not valid JSON."
msgstr "La metadatumoj de la malneto ne estas valida JSON."

#, kde-format
msgid "Draft metadata is too large."
msgstr "La metadatumoj de la malneto estas tro grandaj."

#, kde-format
msgid "Draft metadata must be an object."
msgstr "La metadatumoj de la malneto devas esti objekto."

#, kde-format
msgid "Draft metadata values must be strings."
msgstr "La metadatumaj valoroj de la malneto devas esti ĉenoj."

#, kde-format
msgid "Draft origin split does not exist."
msgstr "La origina disigo de la malneto ne ekzistas."

#, kde-format
msgid "Draft splits are missing."
msgstr "La disigoj de la malneto mankas."

#, kde-format
msgid "Draft tags are missing."
msgstr "La etikedoj de la malneto mankas."

#, kde-format
msgid "Draft transactions"
msgstr "Malnetaj transakcioj"

#, kde-format
msgid "Drafted (UTC)"
msgstr "Movita al malnetoj (UTC)"

#, kde-format
msgid "Drafts"
msgstr "Malnetoj"

#, kde-format
msgid "Drafts do not affect balances. Save the document to keep changes. Restored recovery copies are removed only after a clean save and full verification; cleanup is saved with the next document save."
msgstr "Malnetoj ne influas saldojn. Konservu la dokumenton por reteni ŝanĝojn. Reakiraj kopioj de restarigitaj transakcioj estas forigitaj nur post sukcesa konservado kaj plena kontrolo; la purigado estas konservata ĉe la sekva konservado de la dokumento."

#, kde-format
msgid "Every split will return to its original account. Only the posting date can change; reconciliation flags and dates remain unchanged."
msgstr "Ĉiu disigo revenos al sia origina konto. Nur la enregistra dato povas ŝanĝiĝi; akordigaj markoj kaj datoj restas senŝanĝaj."

#, kde-format
msgid "Filter drafts…"
msgstr "Filtri malnetojn…"

#, kde-format
msgid "Finish the current KMyMoney operation first."
msgstr "Unue finu la nunan operacion de KMyMoney."

#, kde-format
msgid "Frozen"
msgstr "Frostigita"

#, kde-format
msgid "Invalid archived transaction identity or date."
msgstr "Nevalida identigilo aŭ dato de arkivita transakcio."

#, kde-format
msgid "Invalid draft identity or timestamp."
msgstr "Nevalida identigilo aŭ tempomarko de malneto."

#, kde-format
msgid "Invalid draft split."
msgstr "Nevalida disigo de malneto."

#, kde-format
msgid "Invalid draft tag."
msgstr "Nevalida etikedo de malneto."

#, kde-format
msgid "Invalid exact monetary value in draft."
msgstr "Nevalida ekzakta mona valoro en malneto."

#, kde-format
msgid "Invalid matched transaction."
msgstr "Nevalida kongruigita transakcio."

#, kde-format
msgid "Invalid reconciliation state."
msgstr "Nevalida akordiga stato."

#, kde-format
msgid "Invalid restoration recovery record."
msgstr "Nevalida reakira rikordo de restarigo."

#, kde-format
msgid "KMyMoney changed transaction fields during restoration. The operation was rolled back and the draft was retained."
msgstr "KMyMoney ŝanĝis transakciajn kampojn dum restarigo. La operacio estis malfarita kaj la malneto estis retenita."

#, kde-format
msgid "Keep complete transactions in drafts and restore them later"
msgstr "Konservu tutajn transakciojn kiel malnetojn kaj restarigu ilin poste"

#, kde-format
msgid "Matched transaction nesting is too deep."
msgstr "Kongruigitaj transakcioj estas tro profunde nestitaj."

#, kde-format
msgid "Memo"
msgstr "Noto"

#, kde-format
msgid "Missing or duplicate split identity in draft."
msgstr "Mankanta aŭ duobla identigilo de disigo en malneto."

#, kde-format
msgid "Move the complete selected transactions, including every split, to drafts? They will stop affecting all account balances, reports, and reconciliations."
msgstr "Ĉu movi la tutajn elektitajn transakciojn, inkluzive de ĉiuj disigoj, al malnetoj? Ili ĉesos influi ĉiujn kontajn saldojn, raportojn kaj akordigojn."

#, kde-format
msgid "Move to drafts"
msgstr "Movi al malnetoj"

#, kde-format
msgid "Moving or restoring reconciled transactions changes historical balances. If you change the posting date, review the affected reconciliations afterwards."
msgstr "Movi aŭ restarigi akordigitajn transakciojn ŝanĝas historiajn saldojn. Se vi ŝanĝas la enregistran daton, poste kontrolu la trafitajn akordigojn."

#, kde-format
msgid "No draft transactions in this document."
msgstr "Neniuj malnetaj transakcioj en ĉi tiu dokumento."

#, kde-format
msgid "Not reconciled"
msgstr "Ne akordigita"

#, kde-format
msgid "Open a KMyMoney document to view its drafts."
msgstr "Malfermu dokumenton de KMyMoney por vidi ĝiajn malnetojn."

#, kde-format
msgid "Payee"
msgstr "Pagato"

#, kde-format
msgid "Posting date:"
msgstr "Enregistra dato:"

#, kde-format
msgid "Price (exact)"
msgstr "Prezo (ekzakta)"

#, kde-format
msgid "Reconciled"
msgstr "Akordigita"

#, kde-format
msgid "Reconciliation"
msgstr "Akordigo"

#, kde-format
msgid "Reconciliation date"
msgstr "Akordiga dato"

#, kde-format
msgid "Remove saved restoration copies"
msgstr "Forigi kopiojn de konservitaj restarigoj"

#, kde-format
msgid "Restoration requires a valid posting date and no other active operation."
msgstr "Restarigo postulas validan enregistran daton kaj neniun alian aktivan operacion."

#, kde-format
msgid "Restore"
msgstr "Restarigi"

#, kde-format
msgid "Restore draft transaction"
msgstr "Restarigi malnetan transakcion"

#, kde-format
msgid "Restored; recovery copy retained"
msgstr "Restarigita; reakira kopio retenita"

#, kde-format
msgid "Select at least one saved transaction."
msgstr "Elektu almenaŭ unu konservitan transakcion."

#, kde-format
msgid "Shares (exact)"
msgstr "Akcioj (ekzakte)"

#, kde-format
msgid "Show drafts…"
msgstr "Montri malnetojn…"

#, kde-format
msgid "Splits"
msgstr "Disigoj"

#, kde-format
msgid "Status"
msgstr "Stato"

#, kde-format
msgid "The plugin module could not be retained for undo history. Restart KMyMoney and check the plugin installation."
msgstr "Ne eblis reteni la kromprograman modulon por la malfara historio. Rekomencu KMyMoney kaj kontrolu la instaladon de la kromprogramo."

#, kde-format
msgid "The selected ledger split no longer exists."
msgstr "La elektita disigo en la kontolibro ne plu ekzistas."

#, kde-format
msgid "The transaction currency or security no longer exists."
msgstr "La valuto aŭ valorpapero de la transakcio ne plu ekzistas."

#, kde-format
msgid "This draft exceeds the 4 MiB metadata record limit."
msgstr "Ĉi tiu malneto superas la limon de 4 MiB por metadatuma rikordo."

#, kde-format
msgid "This draft has already been restored. Save the document to finish cleanup."
msgstr "Ĉi tiu malneto jam estis restarigita. Konservu la dokumenton por fini la purigadon."

#, kde-format
msgid "This draft no longer exists."
msgstr "Ĉi tiu malneto ne plu ekzistas."

#, kde-format
msgid "This transaction already has a draft or a pending restoration record. Save the document first."
msgstr "Ĉi tiu transakcio jam havas malneton aŭ atendantan restarigan rikordon. Unue konservu la dokumenton."

#, kde-format
msgid "This transaction cannot be archived without changes."
msgstr "Ĉi tiu transakcio ne povas esti arkivita sen ŝanĝoj."

#, kde-format
msgid "Unable to move to drafts"
msgstr "Ne eblas movi al malnetoj"

#, kde-format
msgid "Unable to read drafts: %1"
msgstr "Ne eblas legi malnetojn: %1"

#, kde-format
msgid "Unable to restore draft"
msgstr "Ne eblas restarigi malneton"

#, kde-format
msgid "Unknown"
msgstr "Nekonata"

#, kde-format
msgid "Unknown or missing draft fields. Archive left unchanged."
msgstr "Nekonataj aŭ mankantaj kampoj de malneto. La arkivo restis senŝanĝa."

#, kde-format
msgid "Unsupported draft metadata version. Update the plugin before changing drafts."
msgstr "Nesubtenata versio de malnetaj metadatumoj. Ĝisdatigu la kromprogramon antaŭ ol ŝanĝi malnetojn."

#, kde-format
msgid "Value"
msgstr "Valoro"

#, kde-format
msgid "Value (%1)"
msgstr "Valoro (%1)"
