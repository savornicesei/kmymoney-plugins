#, kde-format
msgid "A split references a missing cost center: %1"
msgstr "Una división fai referencia a un centru de costos que falta: %1"

#, kde-format
msgid "A split references a missing or standard account: %1"
msgstr "Una división fai referencia a una cuenta que falta o ye estándar: %1"

#, kde-format
msgid "A split references a missing payee: %1"
msgstr "Una división fai referencia a un beneficiariu que falta: %1"

#, kde-format
msgid "A split references a missing tag: %1"
msgstr "Una división fai referencia a una etiqueta que falta: %1"

#, kde-format
msgid "Account"
msgstr "Cuenta"

#, kde-format
msgid "Account '%1' is closed. Reopen it in KMyMoney before moving or restoring this transaction."
msgstr "La cuenta «%1» ta zarrada. Ábrila otra vegada en KMyMoney enantes de mover o restaurar esta transaición."

#, kde-format
msgid "All splits (read-only; exact amounts are shown as fractions)"
msgstr "Toles divisiones (namás llectura; los importes esautos amuésense como fracciones)"

#, kde-format
msgid "Cleared"
msgstr "Comprobada"

#, kde-format
msgid "Currency"
msgstr "Moneda"

#, kde-format
msgid "Date"
msgstr "Data"

#, kde-format
msgid "Draft"
msgstr "Borrador"

#, kde-format
msgid "Draft checksum mismatch. The archive was not changed."
msgstr "La suma de comprobación del borrador nun coincide. Nun se modificó l'archivu."

#, kde-format
msgid "Draft contains missing, unknown, or noncanonical transaction fields."
msgstr "El borrador contién campos de transaición que falten, son desconocíos o nun son canónicos."

#, kde-format
msgid "Draft identity does not match its metadata key. No drafts were changed."
msgstr "L'identificador del borrador nun coincide cola clave de los metadatos. Nun se modificó nengún borrador."

#, kde-format
msgid "Draft metadata is not valid JSON."
msgstr "Los metadatos del borrador nun son JSON válidu."

#, kde-format
msgid "Draft metadata is too large."
msgstr "Los metadatos del borrador son demasiao grandes."

#, kde-format
msgid "Draft metadata must be an object."
msgstr "Los metadatos del borrador han ser un oxetu."

#, kde-format
msgid "Draft metadata values must be strings."
msgstr "Los valores de los metadatos del borrador han ser cadenes."

#, kde-format
msgid "Draft origin split does not exist."
msgstr "La división orixinal del borrador nun esiste."

#, kde-format
msgid "Draft splits are missing."
msgstr "Falten les divisiones del borrador."

#, kde-format
msgid "Draft tags are missing."
msgstr "Falten les etiquetes del borrador."

#, kde-format
msgid "Draft transactions"
msgstr "Transaiciones en borrador"

#, kde-format
msgid "Drafted (UTC)"
msgstr "Movida a borradores (UTC)"

#, kde-format
msgid "Drafts"
msgstr "Borradores"

#, kde-format
msgid "Drafts do not affect balances. Save the document to keep changes. Restored recovery copies are removed only after a clean save and full verification; cleanup is saved with the next document save."
msgstr "Los borradores nun afecten a los saldos. Guarda'l documentu pa caltener los cambios. Les copies de recuperación de les transaiciones restauraes namás s'eliminen dempués de guardar correutamente y facer una verificación completa; la llimpieza guárdase na siguiente guarda del documentu."

#, kde-format
msgid "Every split will return to its original account. Only the posting date can change; reconciliation flags and dates remain unchanged."
msgstr "Cada división va volver a la so cuenta orixinal. Namás se pue cambiar la data de contabilización; les marques y les dates de conciliación nun cambien."

#, kde-format
msgid "Filter drafts…"
msgstr "Peñerar borradores…"

#, kde-format
msgid "Finish the current KMyMoney operation first."
msgstr "Termina primero la operación actual de KMyMoney."

#, kde-format
msgid "Frozen"
msgstr "Conxelada"

#, kde-format
msgid "Invalid archived transaction identity or date."
msgstr "Identificador o data de la transaición archivada non válidos."

#, kde-format
msgid "Invalid draft identity or timestamp."
msgstr "Identificador o marca temporal del borrador non válidos."

#, kde-format
msgid "Invalid draft split."
msgstr "División del borrador non válida."

#, kde-format
msgid "Invalid draft tag."
msgstr "Etiqueta del borrador non válida."

#, kde-format
msgid "Invalid exact monetary value in draft."
msgstr "Valor monetariu esautu non válidu nel borrador."

#, kde-format
msgid "Invalid matched transaction."
msgstr "Transaición empareyada non válida."

#, kde-format
msgid "Invalid reconciliation state."
msgstr "Estáu de conciliación non válidu."

#, kde-format
msgid "Invalid restoration recovery record."
msgstr "Rexistru de recuperación de la restauración non válidu."

#, kde-format
msgid "KMyMoney changed transaction fields during restoration. The operation was rolled back and the draft was retained."
msgstr "KMyMoney cambió campos de la transaición na restauración. Desfíxose la operación y caltúvose'l borrador."

#, kde-format
msgid "Keep complete transactions in drafts and restore them later"
msgstr "Caltén transaiciones completes en borradores y restáurales más tarde"

#, kde-format
msgid "Matched transaction nesting is too deep."
msgstr "Les transaiciones empareyaes tán añeraes a demasiada fondura."

#, kde-format
msgid "Memo"
msgstr "Nota"

#, kde-format
msgid "Missing or duplicate split identity in draft."
msgstr "Falta l'identificador d'una división nel borrador o ta duplicáu."

#, kde-format
msgid "Move the complete selected transactions, including every split, to drafts? They will stop affecting all account balances, reports, and reconciliations."
msgstr "¿Mover les transaiciones seleicionaes completes, incluyendo toles divisiones, a borradores? Van dexar d'afectar a los saldos de toles cuentes, los informes y les conciliaciones."

#, kde-format
msgid "Move to drafts"
msgstr "Mover a borradores"

#, kde-format
msgid "Moving or restoring reconciled transactions changes historical balances. If you change the posting date, review the affected reconciliations afterwards."
msgstr "Mover o restaurar transaiciones conciliaes cambia los saldos históricos. Si cambies la data de contabilización, revisa dempués les conciliaciones afectaes."

#, kde-format
msgid "No draft transactions in this document."
msgstr "Nun hai transaiciones en borrador nesti documentu."

#, kde-format
msgid "Not reconciled"
msgstr "Ensin conciliar"

#, kde-format
msgid "Open a KMyMoney document to view its drafts."
msgstr "Abri un documentu de KMyMoney pa ver los sos borradores."

#, kde-format
msgid "Payee"
msgstr "Beneficiariu"

#, kde-format
msgid "Posting date:"
msgstr "Data de contabilización:"

#, kde-format
msgid "Price (exact)"
msgstr "Preciu (esautu)"

#, kde-format
msgid "Reconciled"
msgstr "Conciliada"

#, kde-format
msgid "Reconciliation"
msgstr "Conciliación"

#, kde-format
msgid "Reconciliation date"
msgstr "Data de conciliación"

#, kde-format
msgid "Remove saved restoration copies"
msgstr "Quitar les copies de les restauraciones guardaes"

#, kde-format
msgid "Restoration requires a valid posting date and no other active operation."
msgstr "La restauración requier una data de contabilización válida y nenguna otra operación activa."

#, kde-format
msgid "Restore"
msgstr "Restaurar"

#, kde-format
msgid "Restore draft transaction"
msgstr "Restaurar la transaición en borrador"

#, kde-format
msgid "Restored; recovery copy retained"
msgstr "Restaurada; caltúvose la copia de recuperación"

#, kde-format
msgid "Select at least one saved transaction."
msgstr "Seleiciona polo menos una transaición guardada."

#, kde-format
msgid "Shares (exact)"
msgstr "Participaciones (esautes)"

#, kde-format
msgid "Show drafts…"
msgstr "Amosar borradores…"

#, kde-format
msgid "Splits"
msgstr "Divisiones"

#, kde-format
msgid "Status"
msgstr "Estáu"

#, kde-format
msgid "The plugin module could not be retained for undo history. Restart KMyMoney and check the plugin installation."
msgstr "Nun se pudo caltener el módulu del complementu pal historial de desfacer. Reanicia KMyMoney y comprueba la instalación del complementu."

#, kde-format
msgid "The selected ledger split no longer exists."
msgstr "La división seleicionada nel llibru mayor yá nun esiste."

#, kde-format
msgid "The transaction currency or security no longer exists."
msgstr "La moneda o'l valor mobiliariu de la transaición yá nun esiste."

#, kde-format
msgid "This draft exceeds the 4 MiB metadata record limit."
msgstr "Esti borrador supera la llende de 4 MiB por rexistru de metadatos."

#, kde-format
msgid "This draft has already been restored. Save the document to finish cleanup."
msgstr "Esti borrador yá se restauró. Guarda'l documentu pa terminar la llimpieza."

#, kde-format
msgid "This draft no longer exists."
msgstr "Esti borrador yá nun esiste."

#, kde-format
msgid "This transaction already has a draft or a pending restoration record. Save the document first."
msgstr "Esta transaición yá tien un borrador o un rexistru de restauración pendiente. Guarda primero'l documentu."

#, kde-format
msgid "This transaction cannot be archived without changes."
msgstr "Esta transaición nun se pue archivar ensin cambios."

#, kde-format
msgid "Unable to move to drafts"
msgstr "Nun se pue mover a borradores"

#, kde-format
msgid "Unable to read drafts: %1"
msgstr "Nun se puen lleer los borradores: %1"

#, kde-format
msgid "Unable to restore draft"
msgstr "Nun se pue restaurar el borrador"

#, kde-format
msgid "Unknown"
msgstr "Desconocíu"

#, kde-format
msgid "Unknown or missing draft fields. Archive left unchanged."
msgstr "Campos del borrador desconocíos o que falten. L'archivu nun se modificó."

#, kde-format
msgid "Unsupported draft metadata version. Update the plugin before changing drafts."
msgstr "Versión de los metadatos del borrador non compatible. Anueva'l complementu enantes de cambiar borradores."

#, kde-format
msgid "Value"
msgstr "Valor"

#, kde-format
msgid "Value (%1)"
msgstr "Valor (%1)"
