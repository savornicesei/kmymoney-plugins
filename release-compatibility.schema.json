{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KMyMoney plugin release compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "plugins": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9][a-z0-9_-]*$": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kmymoney", "qtMajor"],
              "properties": {
                "kmymoney": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^([A-Za-z][A-Za-z0-9_-]*|[0-9]+\\.[0-9]+(\\.[0-9]+)?|[0-9*?]+(\\.[0-9*?]+){1,2}|[0-9]+\\.[0-9]+(\\.[0-9]+)? - [0-9]+\\.[0-9]+(\\.[0-9]+)?)$"
                  }
                },
                "qtMajor": {"type": "integer", "enum": [5, 6]},
                "notes": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
